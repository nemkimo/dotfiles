{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/instructions/*.md"],
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "sort *": "allow",
      "tail *": "allow",
    },
    "edit": "deny",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "read": "allow",
    "task": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask",
  },
  "agent": {
    "plan": {
      "temperature": 0.1,
    },
    "build": {
      "temperature": 0.3,
      "permission": {
        "edit": "ask",
      },
    },
  },
}
