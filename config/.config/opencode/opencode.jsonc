{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "instructions": ["~/.config/opencode/instructions/*.md"],
  "permission": {
    "*": "ask",
    "bash": {
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "read": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
  },
}
